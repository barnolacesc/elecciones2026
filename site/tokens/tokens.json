{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "elecciones2026-design-tokens",
  "version": "1.0.0",
  "description": "Local design tokens for Elecciones 2026 MVP mobile-first static comparator. Zero external CDN dependencies.",
  "tokens": {
    "color": {
      "bg": {
        "canvas": {
          "value": "#f8f9f7",
          "description": "Primary page canvas background. Calm neutral tone."
        },
        "surface": {
          "value": "#ffffff",
          "description": "Surface background for cards, controls, and dialogs."
        },
        "surfaceSubtle": {
          "value": "#f0f4f6",
          "description": "Subtle container fill for secondary sections and code blocks."
        },
        "surfaceAlt": {
          "value": "#eaf2f3",
          "description": "Alternate container background for analytical callouts."
        },
        "notice": {
          "value": "#fff7df",
          "description": "Background for prototype preview banners and editorial notices."
        },
        "primary": {
          "value": "#164f67",
          "description": "Primary action button background. Deep civic teal."
        },
        "primaryHover": {
          "value": "#0e394e",
          "description": "Primary action background on hover or active press."
        },
        "previewBanner": {
          "value": "#173d64",
          "description": "High-contrast top banner background for preview environment notice."
        }
      },
      "text": {
        "primary": {
          "value": "#14253a",
          "description": "Primary body copy and headings. High contrast on canvas (14.7:1) and surface (15.5:1)."
        },
        "secondary": {
          "value": "#526675",
          "description": "Secondary labels, descriptions, and metadata. Contrast > 5.5:1 on white."
        },
        "muted": {
          "value": "#687987",
          "description": "Muted supporting text. Meets WCAG AA minimum 4.5:1 on white."
        },
        "inverse": {
          "value": "#ffffff",
          "description": "White text on primary buttons and dark banners (contrast 8.9:1)."
        },
        "brand": {
          "value": "#134e67",
          "description": "Brand text color for headers and emphasis."
        },
        "notice": {
          "value": "#6a5424",
          "description": "Notice text color on notice background (contrast 6.7:1)."
        }
      },
      "border": {
        "subtle": {
          "value": "#dce3e7",
          "description": "Subtle divider and border line."
        },
        "default": {
          "value": "#d4dfe3",
          "description": "Standard border for cards, inputs, and controls."
        },
        "strong": {
          "value": "#526675",
          "description": "High-contrast border meeting 3:1 non-text contrast."
        },
        "notice": {
          "value": "#e7d5a5",
          "description": "Border for warning and editorial notice boxes."
        },
        "focus": {
          "value": "#164f67",
          "description": "Keyboard focus ring indicator color."
        }
      },
      "partyA": {
        "bg": {
          "value": "#d2eaf0",
          "description": "Neutral soft cyan tint for Party A identifier pill."
        },
        "text": {
          "value": "#134e67",
          "description": "High-contrast dark teal text for Party A pill (7.25:1)."
        },
        "border": {
          "value": "#b0d5df",
          "description": "Border for Party A pill."
        }
      },
      "partyB": {
        "bg": {
          "value": "#e6e5f2",
          "description": "Neutral soft lavender tint for Party B identifier pill."
        },
        "text": {
          "value": "#3d3765",
          "description": "High-contrast dark purple text for Party B pill (8.72:1)."
        },
        "border": {
          "value": "#cecde3",
          "description": "Border for Party B pill."
        }
      },
      "status": {
        "official": {
          "bg": { "value": "#d2eaf0" },
          "text": { "value": "#134e67" }
        },
        "partial": {
          "bg": { "value": "#fff7df" },
          "text": { "value": "#6a5424" }
        },
        "missing": {
          "bg": { "value": "#fae8e8" },
          "text": { "value": "#7a2b2b" }
        },
        "announced": {
          "bg": { "value": "#e2eef2" },
          "text": { "value": "#2d5568" }
        },
        "replaced": {
          "bg": { "value": "#f3eee4" },
          "text": { "value": "#5c5240" }
        }
      },
      "relationship": {
        "agreement": {
          "bg": { "value": "#eaf2f3" },
          "text": { "value": "#134e67" },
          "border": { "value": "#c5dde3" }
        },
        "divergence": {
          "bg": { "value": "#eeedf6" },
          "text": { "value": "#3d3765" },
          "border": { "value": "#d1d0e5" }
        },
        "qualification": {
          "bg": { "value": "#fff7df" },
          "text": { "value": "#6a5424" },
          "border": { "value": "#e7d5a5" }
        },
        "notFound": {
          "bg": { "value": "#f0f4f6" },
          "text": { "value": "#526675" },
          "border": { "value": "#d4dfe3" }
        }
      }
    },
    "typography": {
      "fontFamily": {
        "sans": {
          "value": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
          "description": "Local system sans-serif font stack. No external Google Fonts CDN."
        },
        "mono": {
          "value": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
          "description": "System monospace stack for hashes and technical identifiers."
        }
      },
      "fontSize": {
        "xs": { "value": "0.75rem", "px": 12 },
        "sm": { "value": "0.875rem", "px": 14 },
        "base": { "value": "1rem", "px": 16 },
        "lg": { "value": "1.125rem", "px": 18 },
        "xl": { "value": "1.25rem", "px": 20 },
        "2xl": { "value": "1.5rem", "px": 24 },
        "3xl": { "value": "1.875rem", "px": 30 },
        "hero": { "value": "clamp(2rem, 7vw, 3.5rem)", "description": "Fluid headline scaling on mobile" }
      },
      "lineHeight": {
        "tight": { "value": "1.15" },
        "snug": { "value": "1.3" },
        "base": { "value": "1.6" },
        "relaxed": { "value": "1.75" }
      },
      "fontWeight": {
        "regular": { "value": "400" },
        "medium": { "value": "500" },
        "semibold": { "value": "600" },
        "bold": { "value": "700" },
        "extrabold": { "value": "800" }
      },
      "letterSpacing": {
        "tighter": { "value": "-0.05em" },
        "tight": { "value": "-0.025em" },
        "normal": { "value": "0em" },
        "wide": { "value": "0.05em" },
        "wider": { "value": "0.1em" }
      }
    },
    "spacing": {
      "space1": { "value": "0.25rem", "px": 4 },
      "space2": { "value": "0.5rem", "px": 8 },
      "space3": { "value": "0.75rem", "px": 12 },
      "space4": { "value": "1rem", "px": 16 },
      "space5": { "value": "1.25rem", "px": 20 },
      "space6": { "value": "1.5rem", "px": 24 },
      "space8": { "value": "2rem", "px": 32 },
      "space10": { "value": "2.5rem", "px": 40 },
      "space12": { "value": "3rem", "px": 48 },
      "space16": { "value": "4rem", "px": 64 }
    },
    "size": {
      "touchTargetMin": {
        "value": "44px",
        "description": "Strict WCAG 2.5.5 / 2.5.8 minimum touch target dimension."
      },
      "touchTargetComfortable": {
        "value": "48px",
        "description": "Comfortable mobile touch target dimension for primary inputs and buttons."
      },
      "containerMaxWidth": {
        "value": "1180px",
        "description": "Maximum page container width on desktop."
      },
      "contentMaxWidth": {
        "value": "720px",
        "description": "Optimal reading line-length container width."
      }
    },
    "radius": {
      "sm": { "value": "0.25rem", "px": 4 },
      "md": { "value": "0.5rem", "px": 8 },
      "lg": { "value": "0.75rem", "px": 12 },
      "xl": { "value": "1rem", "px": 16 },
      "full": { "value": "9999px" }
    },
    "border": {
      "widthDefault": { "value": "1px" },
      "widthFocus": { "value": "2px" }
    },
    "shadow": {
      "sm": { "value": "0 1px 2px 0 rgba(20, 37, 58, 0.05)" },
      "md": { "value": "0 4px 6px -1px rgba(20, 37, 58, 0.08)" }
    },
    "focus": {
      "outlineWidth": { "value": "2px" },
      "outlineOffset": { "value": "2px" },
      "outlineColor": { "value": "#164f67" },
      "ring": { "value": "0 0 0 2px #ffffff, 0 0 0 4px #164f67" }
    },
    "breakpoint": {
      "mobileCompact": {
        "value": "360px",
        "description": "Compact phone viewport (e.g. iPhone SE, budget Android)."
      },
      "mobileBaseline": {
        "value": "390px",
        "description": "Baseline phone viewport (e.g. iPhone 12/13/14/15/16)."
      },
      "mobileLarge": {
        "value": "430px",
        "description": "Large phone viewport (e.g. iPhone Plus / Pro Max)."
      },
      "desktop": {
        "value": "760px",
        "description": "Progressive enhancement desktop layout threshold."
      }
    }
  },
  "rules": {
    "noExternalCdn": true,
    "noProfileUi": true,
    "noFakeVerificationClaims": true,
    "minTouchTargetPx": 44,
    "wcagLevel": "AA"
  }
}
